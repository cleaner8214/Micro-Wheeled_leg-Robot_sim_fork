<mujoco model="micro_wheeled_leg_sim">
  <!-- Simplified 4-actuator model, NOT a CAD-accurate replica.
       +X forward, +Y left, +Z up. Masses and dimensions are assumptions. -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"/>
  <default>
    <joint damping="0.001" armature="0.00001"/>
    <geom friction="1.2 0.005 0.0001" condim="3" solref="0.003 1" solimp="0.9 0.95 0.001"/>
  </default>
  <statistic center="0 0 0.07" extent="0.18"/>
  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.25 0.25 0.25" specular="0.3 0.3 0.3"/>
    <rgba haze="0.1 0.15 0.2 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>
  <asset>
    <material name="chassis" rgba="0.15 0.22 0.27 1"/>
    <material name="link" rgba="0.24 0.58 0.75 1"/>
    <material name="tire" rgba="0.09 0.09 0.10 1"/>
    <material name="floor" rgba="0.77 0.78 0.79 1"/>
  </asset>
  <worldbody>
    <light name="sun" pos="0 0 1" dir="0 0 -1"/>
    <geom name="ground" type="plane" pos="0 0 0" size="2 2 0.01" material="floor"/>
    <body name="base" pos="0 0 0.086">
      <freejoint name="root"/>
      <geom name="chassis" type="box" size="0.029 0.030 0.014" mass="0.20" material="chassis"/>
      <site name="imu" size="0.002" pos="0 0 0"/>
      <body name="left_leg" pos="0 0.034 0">
        <joint name="left_hip" type="hinge" axis="1 0 0" range="-0.95 0.95"/>
        <geom name="left_link" type="capsule" fromto="0 0 -0.004 0 0 -0.067" size="0.0045" mass="0.026" material="link"/>
        <body name="left_wheel" pos="0 0 -0.071">
          <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.00002"/>
          <geom name="left_tire" type="cylinder" size="0.015 0.007" euler="1.5707963267948966 0 0" mass="0.025" material="tire"/>
        </body>
      </body>
      <body name="right_leg" pos="0 -0.034 0">
        <joint name="right_hip" type="hinge" axis="1 0 0" range="-0.95 0.95"/>
        <geom name="right_link" type="capsule" fromto="0 0 -0.004 0 0 -0.067" size="0.0045" mass="0.026" material="link"/>
        <body name="right_wheel" pos="0 0 -0.071">
          <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.00002"/>
          <geom name="right_tire" type="cylinder" size="0.015 0.007" euler="1.5707963267948966 0 0" mass="0.025" material="tire"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="left_wheel_torque" joint="left_wheel_joint" gear="1" ctrlrange="-0.035 0.035"/>
    <motor name="right_wheel_torque" joint="right_wheel_joint" gear="1" ctrlrange="-0.035 0.035"/>
    <position name="left_hip_target" joint="left_hip" kp="2.5" kv="0.045" ctrlrange="-0.90 0.90" forcerange="-0.25 0.25"/>
    <position name="right_hip_target" joint="right_hip" kp="2.5" kv="0.045" ctrlrange="-0.90 0.90" forcerange="-0.25 0.25"/>
  </actuator>
  <sensor>
    <gyro name="base_gyro" site="imu"/>
    <framequat name="base_orientation" objtype="body" objname="base"/>
    <jointpos name="left_hip_pos" joint="left_hip"/>
    <jointpos name="right_hip_pos" joint="right_hip"/>
    <jointvel name="left_wheel_speed" joint="left_wheel_joint"/>
    <jointvel name="right_wheel_speed" joint="right_wheel_joint"/>
  </sensor>
</mujoco>
